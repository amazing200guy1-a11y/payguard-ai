# PayGuard AI — PayPal Sandbox / Production Configuration
# Get your free sandbox credentials at: https://developer.paypal.com/dashboard/applications/sandbox

PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_SANDBOX=true

# Security Circuit Breaker Policies
MAX_TRANSACTION_CENTS=5000       # $50.00 maximum autonomous order
DAILY_BUDGET_CENTS=20000         # $200.00 rolling 24h spending ceiling
HMAC_SECRET=your_secure_hmac_secret_for_human_approvals

PORT=3000
